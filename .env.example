# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=saas_analytics
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=change-me-in-production

# ── Django ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-50-char-secret-key-here

# Environment: development, staging, production
DJANGO_ENV=production

# JWT signing secret — distinct from DJANGO_SECRET_KEY; Django signs user JWTs
# and FastAPI verifies them. Never use DJANGO_SECRET_KEY here.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_SECRET=your-jwt-signing-secret-here

# FastAPI service authentication secret — used to sign internal service JWTs.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FASTAPI_SERVICE_SECRET=your-fastapi-service-secret-here

# Service token lifetime in seconds (internal JWTs)
SERVICE_TOKEN_LIFETIME_SECONDS=300
JWT_ISSUER=datalens-backend
JWT_AUDIENCE=datalens-api
ANALYTICS_TIMEZONE=UTC
WEEKLY_REPORT_HOUR=8
MAX_UPLOAD_SIZE=10485760

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 django frontend

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Frontend ───────────────────────────────────────────────────────
# Production (Docker) uses relative paths via nginx proxy.
VITE_DJANGO_URL=/api/django
VITE_FASTAPI_URL=/api/analytics

# Public-facing URL for password reset links etc.
FRONTEND_URL=http://localhost:3002

# ── Email ──────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
