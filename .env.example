# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=saas_analytics
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=7d639d76a18c7c033debdf20c11eeab83ebc1ad1e82d53abe300fd1fe192c217

# ── Django ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-50-char-secret-key-here

# JWT signing secret — Django signs tokens with this; FastAPI verifies with the same value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_SECRET=your-jwt-signing-secret-here

# FastAPI service authentication secret — used to sign internal service JWTs.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FASTAPI_SERVICE_SECRET=your-fastapi-service-secret-here

# Legacy static key (deprecated in production; kept for backward compatibility).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_KEY=your-internal-service-key-here

# Service token lifetime in seconds (internal JWTs)
SERVICE_TOKEN_LIFETIME_SECONDS=300

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Frontend ───────────────────────────────────────────────────────
VITE_DJANGO_URL=http://localhost/api/django
VITE_FASTAPI_URL=http://localhost/api/analytics
